{
  "name": "git-feedback-loop",
  "version": "0.2.0",
  "description": "Product feedback, GitHub issue delivery, and a CLI loop for any coding agent.",
  "homepage": "https://github.com/robipop22/git-feedback-loop#readme",
  "bugs": {
    "url": "https://github.com/robipop22/git-feedback-loop/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/robipop22/git-feedback-loop.git"
  },
  "bin": {
    "feedback-loop": "./dist/cli.js"
  },
  "files": [
    "dist",
    "docs",
    "examples",
    "README.md",
    "LICENSE",
    "fixtures"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "default": "./dist/browser/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./worklet": "./dist/browser/pcm-capture.worklet.js",
    "./fixtures/protocol-v1.json": "./fixtures/protocol-v1.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/write-worklet.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.3",
    "jsdom": "^27.4.0",
    "react": "^19.2.7",
    "react-dom": "^19.3.1",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  }
}
